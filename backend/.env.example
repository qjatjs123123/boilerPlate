# 개발용 기본값 — `make setup`이 이 파일을 .env 로 복사한다.
# 앱마다 다른 이름을 쓰면 DB 컨테이너가 섞이지 않는다
COMPOSE_PROJECT_NAME=myapp
POSTGRES_USER=app
POSTGRES_PASSWORD=app_dev_password
POSTGRES_DB=app
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg2://app:app_dev_password@localhost:5432/app
JWT_SECRET=change-me-dev-only
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
DEBUG=false
